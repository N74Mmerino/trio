# Copiar este archivo como ".env" y completar los valores.

APP_URL=http://localhost/consumo-energetico/
DB_HOST=localhost
DB_PORT=3306
DB_NAME=consumo_energetico
DB_USER=
DB_PASS=

# Etapa 16 - Correo (recupero de contraseña).
# Sin MAIL_HOST los correos no se envían: se guardan en storage/correos/ (modo desarrollo).
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SECURE=tls y en MAIL_PASS una "contraseña de aplicación".
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
